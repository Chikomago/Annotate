{
  "$schema": "https://raw.githubusercontent.com/nickelpack/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Annotate",
  "version": "2.0.3",
  "identifier": "com.alan.annotate",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Annotate",
        "width": 420,
        "height": 560,
        "resizable": false,
        "center": true,
        "url": "loading.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5MjFENTcwMzQxOTA2OTkKUldTWkJoazBjTlVocVV6bGcxcVZyRVAwaGhCcHVjUllWdG8veFhpSmtrTWQzcEY0UE14SkhJbzMK",
      "endpoints": ["https://github.com/Chikomago/Annotate/releases/latest/download/latest.json"]
    },
    "shell": {
      "open": true
    }
  }
}
